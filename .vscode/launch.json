{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python: Run Library App (Flask)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/run.py",
            "console": "integratedTerminal",
            "jinja": true,
            "justMyCode": true,
            "env": {
                "FLASK_ENV": "development",
                "FLASK_DEBUG": "1"
            }
        },
        {
            "name": "Python: Run Database Seed Script",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/seed.py",
            "console": "integratedTerminal"
        },
        {
            "name": "Python: Run Pytest Tests",
            "type": "debugpy",
            "request": "launch",
            "module": "pytest",
            "args": ["-v"],
            "console": "integratedTerminal"
        }
    ]
}
